# Holdfast daemon — multi-user deployment with privilege drop.
#
# The network-facing daemon runs as the unprivileged `holdfast` account but
# holds just enough capability (CAP_SETUID + CAP_SETGID) to launch each shell
# under the authenticated user's own Unix account via setpriv (ADR 0007). This
# is the "just enough privilege, never the whole gateway as root" model the
# project plan mandates.
#
# Prerequisites:
#   - setpriv (util-linux) at /usr/bin/setpriv.
#   - Each end user has a real Unix account and an authorized_keys file.
#   - An --account mapping per user (the daemon refuses --drop-privileges
#     without one, so a client can never request an arbitrary account).

[Unit]
Description=Holdfast roaming terminal daemon (multi-user, privilege drop)
After=network-online.target
Wants=network-online.target
# Shells are launched through the socket-activated spawner (ADR 0024); without
# it every OpenShell fails, so the socket must be listening first.
Requires=holdfast-spawner.socket
After=holdfast-spawner.socket

[Service]
Type=simple
User=holdfast
Group=holdfast

# The network-facing process needs almost nothing: bind UDP 443, and read each
# user's ~/.ssh/authorized_keys at startup. Since ADR 0024 it does not fork
# shells at all — CAP_SETUID, CAP_SETGID and CAP_KILL moved to
# holdfast-spawner@.service, which PID 1 forks on its behalf.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH
#
# Safe to bound now, and only now. The bounding set is inherited by every
# descendant and can never be widened again, so while this unit forked the
# shells, any bounding set here also applied to them: `sudo` still yielded uid 0,
# but with no CAP_CHOWN / CAP_DAC_OVERRIDE / CAP_FOWNER, so apt, passwd, ping and
# mount failed with EPERM, and the launcher could not undo it. Shells now come
# from the spawner instead, which PID 1 forks with its own (full) bounding set,
# so this line no longer reaches them.
#
# Keep this in step with AmbientCapabilities above: an ambient capability outside
# the bounding set is silently dropped, and the daemon would fail to bind :443.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_READ_SEARCH

ExecStart=/usr/local/bin/holdfastd \
    --bind 127.0.0.1:8080 \
    --wt-bind 0.0.0.0:443 \
    --wt-cert /etc/holdfast/tls/fullchain.pem \
    --wt-key /etc/holdfast/tls/privkey.pem \
    --web-root /var/lib/holdfast/web \
    --upload-root /tmp/holdfast-uploads \
    --drop-privileges \
    --spawner-socket /run/holdfast/spawn.sock \
    --ssh-auth alice /home/alice/.ssh/authorized_keys \
    --account alice alice \
    --ssh-auth bob /home/bob/.ssh/authorized_keys \
    --account bob bob \
    --allowed-origin https://terminal.example.com \
    --grant-key /var/lib/holdfast/grant.key

Restart=on-failure
RestartSec=2s

# Aggregate containment for the daemon and all user shells (ADR 0009). The
# ceiling lives on holdfast.slice, which this unit and every spawner instance
# join: since ADR 0024 the shells are no longer in this unit's cgroup, so a
# TasksMax= here would bound the daemon alone and silently stop containing them.
Slice=holdfast.slice

# --- Sandboxing ---
# NoNewPrivileges must stay OFF, though no longer for the original reason: the
# shells moved to holdfast-spawner@.service (ADR 0024), so setuid-root programs
# in a *shell* are that unit's concern now. What still needs it here is PAM —
# pam_unix verifies passwords through /usr/sbin/unix_chkpwd, which is setgid
# `shadow`, and NoNewPrivileges=yes would break --password-auth entirely.
NoNewPrivileges=no
PrivateTmp=no
# Do NOT set ProtectHome/ProtectSystem=strict: the daemon reads each user's
# ~/.ssh/authorized_keys (that is what CAP_DAC_READ_SEARCH is for), and the
# spawner needs users' home directories to exist for their shells.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictRealtime=yes
# Home of grant.key: persistent grants + stable server identity (ADR 0017).
StateDirectory=holdfast

[Install]
WantedBy=multi-user.target
